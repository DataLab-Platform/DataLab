<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.datalab_platform.datalab</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>BSD-3-Clause</project_license>

  <name>DataLab</name>
  <summary>Process and visualize scientific signals and images</summary>
  <developer id="io.github.datalab_platform">
    <name>DataLab Platform Developers</name>
  </developer>

  <description>
    <p>
      DataLab is an open-source platform for scientific and technical data processing and visualization, with features designed to meet industrial requirements.
    </p>
    <ul>
      <li>Process signals (1D): FFT, filtering, fitting, peak detection, stability analysis and more</li>
      <li>Process images (2D): filtering, morphology, edge detection, blob detection and more</li>
      <li>Apply processing in batches, with regions of interest</li>
      <li>Record a history of actions and replay it on new data</li>
      <li>Automate tasks with Python macros and extend the application with plugins</li>
      <li>Control DataLab remotely from Jupyter, Spyder or any IDE through XML-RPC or an HTTP/JSON web API</li>
      <li>Import and export data in HDF5 format</li>
    </ul>
  </description>

  <launchable type="desktop-id">DataLab.desktop</launchable>
  <provides>
    <binary>datalab</binary>
  </provides>

  <categories>
    <category>Science</category>
    <category>Education</category>
    <category>Physics</category>
    <category>DataVisualization</category>
  </categories>
  <keywords>
    <keyword>signal processing</keyword>
    <keyword>image processing</keyword>
    <keyword>data visualization</keyword>
    <keyword>FFT</keyword>
    <keyword>curve fitting</keyword>
    <keyword>HDF5</keyword>
  </keywords>

