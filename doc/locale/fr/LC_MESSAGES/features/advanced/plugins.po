msgstr "|card-icon-code|  Développer des plugins"

msgid "Quick start, plugin generator, plugin API, examples and publication in the catalog"
msgstr "Démarrage rapide, générateur de plugins, API des plugins, exemples et publication dans le catalogue"

msgid "card-icon-apps  Application plugins"
msgstr "|card-icon-apps|  Plugins d'application"

msgid "Headless recipes, packaged examples, tools, instruments and welcome page tiles"
msgstr "Recettes sans interface graphique, exemples packagés, outils, instruments et tuiles de la page d'accueil"

